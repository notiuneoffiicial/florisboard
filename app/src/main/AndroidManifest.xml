<?xml version="1.0" encoding="utf-8"?>
<!--
  Tiune fork: this is a LIBRARY manifest. It merges into the embedding app's
  (Tiune's) manifest, which owns the <application> identity — name, icon,
  label, theme — and registers the input method service itself, as a subclass
  of FlorisImeService. What is declared here is everything the keyboard needs
  that the host would otherwise have to know about: permissions, the settings
  activity, the spell checker, and the clipboard media provider.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission needed to vibrate if the user has key press vibration enabled -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        tools:targetApi="tiramisu">

        <!-- Tiune fork: FlorisBoard's system spell-checker service is NOT
             registered. The keyboard marks a misspelling itself, by committing
             the word with a SuggestionSpan (EditorInstance.underlineTypoIfAny),
             so the service added nothing — and its settings activity,
             `SettingsLauncherAlias`, does not exist in this app, so the gear
             beside "Tiune" in Android's spell-checker settings failed. -->

        <!-- Keyboard settings (layouts, themes, typing, clipboard, ...) -->
        <activity
            android:name="dev.patrickgold.florisboard.app.FlorisAppActivity"
            android:icon="@mipmap/floris_app_icon"
            android:label="@string/settings__title"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/floris_app_icon_round"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/FlorisAppTheme.Splash"
            android:exported="false">
        </activity>

        <!-- Tiune fork: FlorisBoard's crash dialog is NOT registered, and its
             handler is not installed (see FlorisApplication.installCrashHandler).
             It showed a stack trace headed "FlorisBoard", a link to
             FlorisBoard's releases, and a button opening FlorisBoard's GitHub
             issue tracker — to a Tiune customer, for a crash anywhere in the
             process. -->

        <!-- Tiune fork: FlorisBoard's "share an image into the keyboard's
             clipboard" activity is NOT registered. Exported with an image/*
             SEND filter, it put Tiune in the Android share sheet for every
             photo — an entry point Tiune never documents and nobody expects
             from a dictation keyboard. -->

        <!-- Clipboard Media File Provider -->
        <provider
            android:name="dev.patrickgold.florisboard.ime.clipboard.provider.ClipboardMediaProvider"
            android:authorities="${applicationId}.provider.clipboard"
            android:grantUriPermissions="true"
            android:exported="false">
        </provider>

        <!-- The "${applicationId}.provider.file" FileProvider is declared by the
             embedding app, whose own FileProvider carries both authorities
             (Android allows one FileProvider class per app). -->

        <!-- Disable default EmojiCompat initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove"/>
        </provider>

    </application>

</manifest>
